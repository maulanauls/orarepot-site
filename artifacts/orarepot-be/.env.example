POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=orarepot
POSTGRES_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Kafka (SASL). Offline: docker compose --profile local-kafka up -d
# and KAFKA_BROKERS=localhost:9092 (no username)
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
KAFKA_SSL=false

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=orarepot
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=orarepot
JWT_SECRET=
INTERNAL_KEY=
GATEWAY_PORT=8080

# Build locally from POSTGRES_* (URL-encode special chars in the password).
# Do not commit real host/user/password values.
DATABASE_URL_IDENTITY=postgres://USER:PASSWORD@HOST:PORT/orarepot_identity
DATABASE_URL_MEMBERS=postgres://USER:PASSWORD@HOST:PORT/orarepot_members
DATABASE_URL_MERCHANT=postgres://USER:PASSWORD@HOST:PORT/orarepot_merchant
DATABASE_URL_BILLING=postgres://USER:PASSWORD@HOST:PORT/orarepot_billing
DATABASE_URL_TEMPLATES=postgres://USER:PASSWORD@HOST:PORT/orarepot_templates
DATABASE_URL_OTP=postgres://USER:PASSWORD@HOST:PORT/orarepot_otp
DATABASE_URL_DEVELOPER=postgres://USER:PASSWORD@HOST:PORT/orarepot_developer
DATABASE_URL_WAREHOUSE=postgres://USER:PASSWORD@HOST:PORT/orarepot_warehouse

# WhatsApp Cloud API — Ora Repot sender (Phone Number ID, not WABA)
WHATSAPP_STUB=false
META_GRAPH_VERSION=v26.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_OTP_TEMPLATE_EN=otp_merchant
META_OTP_TEMPLATE_EN_LANG=en
META_OTP_TEMPLATE_ID=otp_merchant_id
META_OTP_TEMPLATE_ID_LANG=id
META_WA_TOKEN=

# Midtrans (billing callback + Snap). Notification URL:
#   https://api.orarepot.com/billing/payments/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
PUBLIC_APP_URL=https://orarepot.com

# Mailjet (member invites). Verify MAILJET_FROM_EMAIL in Mailjet → Sender addresses.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=hello@orarepot.com
MAILJET_FROM_NAME=Ora Repot
